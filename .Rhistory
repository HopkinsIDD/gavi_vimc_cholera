filepath <- 'C:/Users/zheng/Cholera/gavi_vimc_cholera_local/postprocessing_functions/COD_no-vaccination_zero_incid_trend_FALSE_outb_layer_FALSE_stoch.csv'
output <- read.csv(filepath)
head(output)
colnames(output)
adjust_cases <- function(df, use_stochastic = F, multipler = 1) {
multiplier <- if (use_stochastic) multipler else stop("stochastic scaling for cases is not implemented yet.")
df$cases <- df$cases * multiplier
return(df)
}
adjust_deaths <- function(df, use_stochastic = F, multipler = 1) {
multiplier <- if (use_stochastic) multipler else stop("stochastic scaling for deaths is not implemented yet.")
df$deaths <- df$deaths * multiplier
return(df)
}
adjust_DALYs <- function(df, cases_use_stochastic = F, deaths_use_stochastic = F, cases_multipler = 1, deaths_multipler = 1) {
cases_multipler <- if (cases_use_stochastic) cases_multipler else stop("stochastic scaling for deaths is not implemented yet.")
deaths_multipler <- if (deaths_use_stochastic) deaths_multipler else stop("stochastic scaling for deaths is not implemented yet.")
df$yll <- df$yll * deaths_multipler
df$yld <- (df$dalys-df$yll) * cases_multipler
df$dalys <- df$yld + df$yll
return(df)
}
# Adjust model outputs ----------------------------------------------------
adj_output <- output %>%
adjust_cases(., multipler = 1/0.328) %>%
adjust_deaths(., mutipler = 3.87) %>%
adjust_DALYs(., cases_multipler = 1/0.328, deaths_multipler = 3.87)
