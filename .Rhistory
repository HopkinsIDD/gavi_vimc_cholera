library(sf)
library(sf)
library(dplyr)
library(ggplot2)
sf::sf_use_s2(FALSE)
knitr::opts_knit$set(root.dir = normalizePath("../../"))
extracted_data <- read.csv("Data/extracted_data/processed_cholera_climate_systematic_review_extract_into_sheets.csv")
extracted_data <- extracted_data[1:50,]
## Location shapefiles ----
total_shps <- readRDS("Data/shapefiles/location_shapefiles.rds")
## Location shapefiles ----
total_shps <- readRDS("Data/shapefiles/location_shapefiles.rds")
## Country shapefiles ----
country_shps <- readRDS("Data/shapefiles/country_shapefiles.rds")
merged_data <- dplyr::left_join(total_shps, extracted_data %>% distinct(lctn_pr,eff_admin), by = "lctn_pr")
merged_data <- dplyr::left_join(total_shps, extracted_data %>% distinct(lctn_pr,eff_admin), by = "lctn_pr")
# Ensure factor levels are in the correct plotting order
merged_data <- merged_data %>%
mutate(
eff_admin = factor(eff_admin, levels = c("non-adm geography", "adm0", "adm1", "adm2", "adm3")))
# Plot the data
p <- ggplot() +
# 1. Non-administrative geography (plotted first)
geom_sf(data = merged_data %>% filter(eff_admin == "non-adm geography"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 2. ADM0 (country level)
geom_sf(data = merged_data %>% filter(eff_admin == "adm0"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 3. ADM1 (state/province level)
geom_sf(data = merged_data %>% filter(eff_admin == "adm1"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 4. ADM2 (district/county level)
geom_sf(data = merged_data %>% filter(eff_admin == "adm2"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 5. ADM3 (smallest admin unit, plotted last)
geom_sf(data = merged_data %>% filter(eff_admin == "adm3"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# Define fill colors based on levels
scale_fill_manual(values = setNames(colors_admin_levels(), c("non-adm geography", "adm0", "adm1", "adm2", "adm3")),
name = "Admin Level") +
# Add country boundaries
geom_sf(data = country_shps, fill = NA, color = "black", alpha = 0) +
# Additional plot aesthetics
theme_bw() +
theme(legend.position = "right") +
labs(title = "Spatial Distribution of Extracted Data")
colors_admin_levels <- function(){RColorBrewer::brewer.pal(n=5,name = 'Blues')}
# Plot the data
p <- ggplot() +
# 1. Non-administrative geography (plotted first)
geom_sf(data = merged_data %>% filter(eff_admin == "non-adm geography"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 2. ADM0 (country level)
geom_sf(data = merged_data %>% filter(eff_admin == "adm0"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 3. ADM1 (state/province level)
geom_sf(data = merged_data %>% filter(eff_admin == "adm1"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 4. ADM2 (district/county level)
geom_sf(data = merged_data %>% filter(eff_admin == "adm2"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# 5. ADM3 (smallest admin unit, plotted last)
geom_sf(data = merged_data %>% filter(eff_admin == "adm3"), aes(fill = eff_admin), color = "black", alpha = 0.6) +
# Define fill colors based on levels
scale_fill_manual(values = setNames(colors_admin_levels(), c("non-adm geography", "adm0", "adm1", "adm2", "adm3")),
name = "Admin Level") +
# Add country boundaries
geom_sf(data = country_shps, fill = NA, color = "black", alpha = 0) +
# Additional plot aesthetics
theme_bw() +
theme(legend.position = "right") +
labs(title = "Spatial Distribution of Extracted Data")
# Save the plot
ggplot2::ggsave("Analysis/Figures/spatial distribution.png", plot = p)
